# Copy this file to .env.hivemq on BOTH laptops. Never commit the real file.
# HiveMQ Cloud Overview -> Connection Details
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883

# HiveMQ Cloud -> Access Management -> Access Credentials
MQTT_USERNAME=team11-client
MQTT_PASSWORD=replace-with-your-secret-password
MQTT_TLS=1
