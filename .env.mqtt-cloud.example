# Copy this file to .env.mqtt-cloud on BOTH laptops. Never commit the real file.
# EMQX Cloud Serverless -> Deployment Overview -> Connection Details
MQTT_HOST=your-deployment.emqxsl.com
MQTT_PORT=8883

# EMQX Cloud Serverless -> Access Control -> Authentication
MQTT_USERNAME=team11-client
MQTT_PASSWORD=replace-with-your-secret-password
MQTT_TLS=1
